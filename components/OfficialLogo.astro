---
interface Props {
  type: "safi" | "potrorockets" | "cansat";
  alt?: string;
  class?: string;
  size?: "small" | "medium" | "large" | "hero";
  link?: string;
  lightBackground?: boolean;
}

const {
  type,
  alt,
  class: className = "",
  size = "medium",
  link,
  lightBackground = false
} = Astro.props;

const logos = {
  safi: {
    src: "/images/logos/safi.png",
    alt: "Logo oficial de SAFI"
  },

  potrorockets: {
    src: "/images/logos/potrorockets.png",
    alt: "Logo oficial de PotroRockets"
  },

  cansat: {
    src: "/images/logos/dyson_swarm.png",
    alt: "Logo oficial de CanSat"
  }
};

const logo = logos[type];

const logoAlt = alt || logo.alt;

const logoClasses = [
  "official-logo",
  size,
  className,
  lightBackground ? "light-background" : ""
]
  .filter(Boolean)
  .join(" ");
---

{
  link ? (
    <a
      class="official-logo-link"
      href={link}
      aria-label={logoAlt}
    >
      <span class={logoClasses}>
        <img
          src={logo.src}
          alt={logoAlt}
          loading={size === "hero" ? "eager" : "lazy"}
          onerror="this.onerror=null;this.closest('.official-logo')?.setAttribute('hidden','');"
        />
      </span>
    </a>
  ) : (
    <span class={logoClasses}>
      <img
        src={logo.src}
        alt={logoAlt}
        loading={size === "hero" ? "eager" : "lazy"}
        onerror="this.onerror=null;this.closest('.official-logo')?.setAttribute('hidden','');"
      />
    </span>
  )
}

<style>
  .official-logo-link {
    display: inline-flex;

    width: fit-content;

    color: inherit;

    text-decoration: none;
  }

  .official-logo {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    width: fit-content;
    max-width: 100%;
  }

  .official-logo[hidden] {
    display: none !important;
  }

  .official-logo img {
    display: block;

    width: auto;
    max-width: 100%;

    object-fit: contain;
  }

  /* ===================================================== */
  /* PEQUEÑO */
  /* ===================================================== */

  .official-logo.small img {
    max-width: 110px;
    max-height: 38px;
  }

  /* ===================================================== */
  /* MEDIANO */
  /* ===================================================== */

  .official-logo.medium img {
    max-width: 180px;
    max-height: 64px;
  }

  /* ===================================================== */
  /* GRANDE */
  /* ===================================================== */

  .official-logo.large img {
    max-width: 260px;
    max-height: 110px;
  }

  /* ===================================================== */
  /* HERO */
  /* ===================================================== */

  .official-logo.hero img {
    max-width: 320px;
    max-height: 150px;
  }

  /* ===================================================== */
  /* FONDO CLARO OPCIONAL */
  /* ===================================================== */

  .official-logo.light-background {
    padding: 12px 16px;

    background: white;

    border:
      1px solid rgba(255,255,255,.08);
  }
</style>