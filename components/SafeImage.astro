---
interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
}

const {
  src,
  alt,
  class: className = "",
  loading = "lazy",
  fetchpriority = "auto"
} = Astro.props;
---

<img
  src={src}
  alt={alt}
  class={className}
  loading={loading}
  fetchpriority={fetchpriority}
  onerror="this.onerror=null;this.src='/images/coming-soon.jpg';"
/>
