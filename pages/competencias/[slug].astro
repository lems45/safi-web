---
import Layout from "../../layouts/Layout.astro";
import SafeImage from "../../components/SafeImage.astro";
import ImageCarousel from "../../components/ImageCarousel.astro";
import OfficialLogo from "../../components/OfficialLogo.astro";
import { competencias } from "../../data/competitions";

export function getStaticPaths() {
  return competencias
    .filter((competencia) => competencia.slug !== "lasc-2026")
    .map((competencia) => ({
      params: { slug: competencia.slug },
      props: { competencia }
    }));
}

const { competencia } = Astro.props;

const esCansat =
  competencia.mision.toLowerCase().includes("cansat") ||
  competencia.vehiculo.toLowerCase().includes("satbee");

const logoEquipo = esCansat ? "cansat" : "potrorockets";

const imagenes = competencia.galeria.map((src, index) => ({
  src,
  alt: `${competencia.nombre} - imagen ${index + 1}`,
  caption: `${competencia.nombre} / ${String(index + 1).padStart(2, "0")}`
}));
---

<Layout
  title={`${competencia.nombre} | SAFI`}
  description={competencia.resumen}
>
  <section class="hero">
    <div class="image">
      <SafeImage
        src={competencia.imagen}
        alt={competencia.nombreCompleto}
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="shade"></div>

    <div class="container content">
      <div class="competition-logos">
        <OfficialLogo
          type={logoEquipo}
          size="medium"
          alt={esCansat ? "CanSat" : "PotroRockets"}
        />

        <OfficialLogo
          type="safi"
          size="small"
          alt="SAFI"
        />
      </div>

      <small>
        SAFI / COMPETENCIAS / {competencia.year}
      </small>

      <h1>{competencia.nombre}</h1>
      <p>{competencia.nombreCompleto}</p>
      <span>● {competencia.estado}</span>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      <div>
        <div class="label">RESUMEN DE MISIÓN</div>

        <h2 class="title">
          {competencia.year}<br />
          <span>{competencia.vehiculo}</span>
        </h2>
      </div>

      <div>
        <p class="lead">{competencia.resumen}</p>
        <p class="copy">{competencia.detalle}</p>
      </div>
    </div>

    <div class="container stats">
      <div>
        <small>COMPETENCIA</small>
        <strong>{competencia.nombre}</strong>
      </div>

      <div>
        <small>PROYECTO</small>
        <strong>{competencia.vehiculo}</strong>
      </div>

      <div>
        <small>MISIÓN</small>
        <strong>{competencia.mision}</strong>
      </div>

      <div>
        <small>RESULTADO</small>
        <strong>{competencia.resultado}</strong>
      </div>
    </div>
  </section>

  <section class="section galeria">
    <div class="container">
      <div class="label">GALERÍA DE MISIÓN</div>

      <h2 class="title">
        {competencia.nombre}<br />
        <span>{competencia.year}</span>
      </h2>

      <ImageCarousel
        height="580px"
        interval={4200}
        images={imagenes}
      />
    </div>
  </section>
</Layout>

<style>
  .hero {
    min-height: 82vh;
    position: relative;
    display: flex;
    align-items: flex-end;
    padding: 150px 0 70px;
    overflow: hidden;
  }

  .image {
    position: absolute;
    inset: 0;
  }

  .image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg,#05080d,rgba(5,8,13,.45) 65%),
      linear-gradient(90deg,rgba(5,8,13,.82),transparent 70%);
  }

  .content {
    position: relative;
    z-index: 2;
  }

  .competition-logos {
    margin-bottom: 25px;
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .content > small {
    color: var(--accent);
    font-size: 8px;
  }

  .content h1 {
    margin: 18px 0;
    font: 600 clamp(70px,10vw,145px)/.82 var(--display);
    letter-spacing: -.065em;
  }

  .content p { color: #b9c0c7; }

  .content > span {
    display: inline-block;
    margin-top: 18px;
    padding: 7px 9px;
    border: 1px solid rgba(255,255,255,.22);
    color: var(--accent);
    font-size: 7px;
  }

  .copy {
    color: var(--muted);
    line-height: 1.9;
  }

  .stats {
    margin-top: 70px;
    display: grid;
    grid-template-columns: repeat(4,1fr);
    border: 1px solid var(--border);
  }

  .stats div {
    min-height: 120px;
    padding: 22px;
    border-right: 1px solid var(--border);
    background: #080c12;
  }

  .stats small {
    display: block;
    color: #59626d;
    font-size: 7px;
  }

  .stats strong {
    display: block;
    margin-top: 25px;
    font: 500 14px var(--display);
  }

  .galeria { background: #070a0f; }

  .galeria .title { margin-bottom: 50px; }

  @media(max-width:850px) {
    .stats { grid-template-columns: 1fr 1fr; }
  }

  @media(max-width:550px) {
    .stats { grid-template-columns: 1fr; }
  }
</style>
