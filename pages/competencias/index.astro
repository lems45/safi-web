---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import SafeImage from "../../components/SafeImage.astro";
import { competencias } from "../../data/competitions";
---

<Layout
  title="Competencias | SAFI"
  description="Historial de competencias y misiones de SAFI."
>
  <PageHero
    eyebrow="HISTORIAL DE COMPETENCIAS"
    title="CAMINOS"
    outline="RECORRIDOS."
    description="Competencias nacionales e internacionales que documentan la evolución de SAFI desde 2021."
    image="/images/competitions-hero.jpg"
  />

  <section class="section">
    <div class="container grid-2">
      <div>
        <div class="label">HISTORIAL DE MISIONES</div>

        <h2 class="title">
          DEL TALLER<br />
          <span>AL CAMPO.</span>
        </h2>
      </div>

      <p class="lead">
        Cada competencia exige integrar ingeniería, logística, operación y
        trabajo en equipo bajo condiciones reales.
      </p>
    </div>
  </section>

  <section class="timeline-section">
    <div class="container timeline">
      {
        competencias.map((competencia) => (
          <article class="item reveal">
            <div class="axis">
              <span class="marker"></span>
              <span class="year">{competencia.year}</span>
            </div>

            <a
              class="card"
              href={`/competencias/${competencia.slug}`}
            >
              <div class="image">
                <SafeImage
                  src={competencia.imagen}
                  alt={competencia.nombreCompleto}
                />
              </div>

              <div class="content">
                <div class="meta">
                  <span>{competencia.equipo}</span>
                  <span>{competencia.ubicacion}</span>
                </div>

                <small>{competencia.nombreCompleto}</small>
                <h3>{competencia.nombre}</h3>
                <strong>{competencia.resultado}</strong>
                <p>{competencia.resumen}</p>

                <footer>
                  <span>EXPLORAR COMPETENCIA</span>
                  <b>↗</b>
                </footer>
              </div>
            </a>
          </article>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .timeline-section {
    padding: 0 0 120px;
    background: #070a0f;
  }

  .timeline {
    position: relative;
    max-width: 1150px;
  }

  .timeline::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 84px;
    width: 1px;
    background: #2c353f;
  }

  .item {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 40px;
    padding: 50px 0;
  }

  .axis { position: relative; }

  .marker {
    position: absolute;
    top: 8px;
    left: 77px;
    width: 15px;
    height: 15px;
    background: var(--accent);
    border: 3px solid #070a0f;
    outline: 1px solid var(--accent);
    transform: rotate(45deg);
  }

  .year {
    color: #7d8791;
    font: 500 17px var(--display);
  }

  .card {
    display: grid;
    grid-template-columns: .85fr 1.15fr;
    min-height: 400px;
    border: 1px solid var(--border);
    background: #080c12;
    color: inherit;
    text-decoration: none;
    overflow: hidden;
  }

  .image {
    overflow: hidden;
  }

  .image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .content {
    padding: 32px;
    display: flex;
    flex-direction: column;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    color: #5b6570;
    font-size: 7px;
    margin-bottom: 45px;
  }

  .content > small {
    color: var(--accent);
    font-size: 8px;
  }

  .content h3 {
    margin: 10px 0 6px;
    font: 600 38px var(--display);
  }

  .content > strong {
    font: 500 13px var(--display);
  }

  .content p {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.8;
  }

  .content footer {
    margin-top: auto;
    padding-top: 20px;
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--border);
    font-size: 8px;
  }

  @media(max-width:850px) {
    .card { grid-template-columns: 1fr; }
    .image { min-height: 320px; }
  }

  @media(max-width:650px) {
    .timeline::before { left: 15px; }

    .item {
      grid-template-columns: 45px 1fr;
      gap: 15px;
    }

    .marker { left: 8px; }

    .year {
      writing-mode: vertical-rl;
      font-size: 11px;
    }
  }
</style>
