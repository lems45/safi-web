---
import Layout from "../../layouts/Layout.astro";
import SafeImage from "../../components/SafeImage.astro";
import OfficialLogo from "../../components/OfficialLogo.astro";
import { proyectos } from "../../data/site";

export function getStaticPaths() {
  return proyectos
    .filter((proyecto) => proyecto.slug !== "akbal-ii")
    .map((proyecto) => ({
      params: { slug: proyecto.slug },
      props: { proyecto }
    }));
}

const { proyecto } = Astro.props;
const logoEquipo = proyecto.equipo === "PotroRockets" ? "potrorockets" : "cansat";
---

<Layout
  title={`${proyecto.titulo} | SAFI`}
  description={proyecto.resumen}
>
  <section class="hero">
    <div class="image">
      <SafeImage
        src={proyecto.hero}
        alt={proyecto.titulo}
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <div class="shade"></div>

    <div class="container content">
      <div class="project-logos">
        <OfficialLogo
          type={logoEquipo}
          size="medium"
          alt={proyecto.equipo}
        />

        <OfficialLogo
          type="safi"
          size="small"
          alt="SAFI"
        />
      </div>

      <small>
        SAFI / {proyecto.equipo} / {proyecto.categoria}
      </small>

      <h1>{proyecto.titulo}</h1>
      <p>{proyecto.resumen}</p>
      <span>● {proyecto.estado}</span>
    </div>
  </section>

  <section class="section">
    <div class="container grid-2">
      <div>
        <div class="label">DESCRIPCIÓN DEL PROYECTO</div>

        <h2 class="title">
          INGENIERÍA<br />
          <span>EN SISTEMA.</span>
        </h2>
      </div>

      <p class="lead">{proyecto.descripcion}</p>
    </div>

    <div class="container specs">
      {
        proyecto.especificaciones.map(([clave, valor]) => (
          <div>
            <small>{clave}</small>
            <b>{valor}</b>
          </div>
        ))
      }
    </div>
  </section>

  {
    proyecto.sistemas && (
      <section class="section sistemas">
        <div class="container">
          <div class="label">SUBSISTEMAS</div>

          <h2 class="title">
            ARQUITECTURA<br />
            <span>PRINCIPAL.</span>
          </h2>

          <div class="systems-grid">
            {
              proyecto.sistemas.map(([nombre, descripcion], index) => (
                <article>
                  <span>0{index + 1}</span>
                  <h3>{nombre}</h3>
                  <p>{descripcion}</p>
                </article>
              ))
            }
          </div>
        </div>
      </section>
    )
  }
</Layout>

<style>
  .hero {
    min-height: 88vh;
    position: relative;
    display: flex;
    align-items: flex-end;
    padding: 160px 0 70px;
    overflow: hidden;
  }

  .image {
    position: absolute;
    inset: 0;
  }

  .image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg,#05080d,rgba(5,8,13,.35) 65%),
      linear-gradient(90deg,rgba(5,8,13,.75),transparent);
  }

  .content {
    position: relative;
    z-index: 2;
  }

  .project-logos {
    margin-bottom: 25px;
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .content > small {
    color: var(--accent);
    font-size: 8px;
  }

  .content h1 {
    margin: 18px 0;
    font: 600 clamp(70px,12vw,180px)/.8 var(--display);
    letter-spacing: -.07em;
  }

  .content p {
    max-width: 700px;
    color: #c0c6cd;
  }

  .content > span {
    display: inline-block;
    margin-top: 15px;
    padding: 7px 9px;
    border: 1px solid #46505a;
    font-size: 8px;
  }

  .specs {
    margin-top: 70px;
    display: grid;
    grid-template-columns: repeat(3,1fr);
    border: 1px solid var(--border);
  }

  .specs div {
    padding: 25px;
    border: 1px solid var(--border);
  }

  .specs small {
    display: block;
    color: #5d6670;
    font-size: 7px;
  }

  .specs b {
    display: block;
    margin-top: 8px;
    font: 500 16px var(--display);
  }

  .sistemas { background: #070a0f; }

  .systems-grid {
    margin-top: 50px;
    display: grid;
    grid-template-columns: repeat(3,1fr);
  }

  .systems-grid article {
    min-height: 220px;
    padding: 25px;
    border: 1px solid var(--border);
  }

  .systems-grid span {
    color: #505964;
    font-size: 8px;
  }

  .systems-grid h3 {
    margin-top: 65px;
    font: 500 20px var(--display);
  }

  .systems-grid p {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.7;
  }

  @media(max-width:800px) {
    .specs,
    .systems-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media(max-width:520px) {
    .specs,
    .systems-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
