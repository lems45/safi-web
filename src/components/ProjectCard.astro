---
import SafeImage from "./SafeImage.astro";
const { proyecto } = Astro.props;
---

<a
  class="card reveal"
  href={`/proyectos/${proyecto.slug}`}
>
  <div class="img">
    <SafeImage
      src={proyecto.imagen}
      alt={proyecto.titulo}
      loading="lazy"
    />

    <span>{proyecto.estado}</span>
  </div>

  <div class="body">
    <small>
      {proyecto.equipo} / {proyecto.categoria}
    </small>

    <h3>{proyecto.titulo}</h3>

    <p>{proyecto.resumen}</p>

    <div>
      <span>EXPLORAR PROYECTO</span>
      <b>↗</b>
    </div>
  </div>
</a>

<style>
  .card {
    display: block;
    color: inherit;
    background: #080c12;
    border: 1px solid var(--border);
    text-decoration: none;
    transition: .3s;
  }

  .card:hover {
    transform: translateY(-5px);
    border-color: #4b5560;
  }

  .img {
    position: relative;
    height: 290px;
    overflow: hidden;
    background: #05080d;
  }

  .img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(.75);
    transition: .5s;
  }

  .card:hover .img :global(img) {
    transform: scale(1.04);
  }

  .img::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 55%,rgba(5,8,13,.7));
  }

  .img > span {
    position: absolute;
    z-index: 2;
    top: 18px;
    right: 18px;
    padding: 6px 8px;
    border: 1px solid rgba(255,255,255,.2);
    color: white;
    background: rgba(5,8,13,.65);
    font-size: 7px;
    letter-spacing: .12em;
  }

  .body { padding: 25px; }

  .body small {
    color: var(--accent);
    font-size: 8px;
    letter-spacing: .13em;
  }

  .body h3 {
    margin: 8px 0 12px;
    font: 600 28px var(--display);
  }

  .body p {
    min-height: 65px;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.7;
  }

  .body > div {
    margin-top: 20px;
    padding-top: 17px;
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--border);
    color: #cbd0d6;
    font-size: 8px;
    letter-spacing: .12em;
  }
</style>
