---
import { withBase } from "../utils/base";

interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
}

const {
  src,
  alt,
  class: className = "",
  loading = "lazy",
  fetchpriority = "auto"
} = Astro.props;

const finalSrc = src.startsWith("/") ? withBase(src) : src;
const fallback = withBase("/images/coming-soon.jpg");
---

<img
  src={finalSrc}
  alt={alt}
  class={className}
  loading={loading}
  fetchpriority={fetchpriority}
  data-fallback={fallback}
  onerror="if(this.dataset.fallback && !this.dataset.fallbackUsed){this.dataset.fallbackUsed='1';this.src=this.dataset.fallback;}"
/>
