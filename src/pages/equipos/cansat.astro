---
import Layout from "../../layouts/Layout.astro";
import { withBase } from "../../utils/base";

const destino = withBase("/equipos/dyson_swarm");
---

<Layout
  title="Dyson Swarm | SAFI"
  description="Dyson Swarm es el equipo de SAFI especializado en misiones CanSat."
>
  <section class="redirect-page">
    <div class="container redirect-card">
      <span>SAFI / EQUIPOS</span>
      <h1>LA IDENTIDAD CANSAT DE SAFI ES <strong>DYSON SWARM.</strong></h1>
      <p>Esta ruta se conserva para no romper enlaces anteriores. La página oficial del equipo está en Dyson Swarm.</p>
      <a href={destino}>IR A DYSON SWARM →</a>
    </div>
  </section>

  <script define:vars={{ destino }}>
    window.location.replace(destino);
  </script>
</Layout>

<style>
  .redirect-page { min-height:72vh; display:grid; place-items:center; padding:130px 0 80px; background:#05080d; }
  .redirect-card { max-width:820px; }
  .redirect-card > span { color:var(--accent); font-size:11px; letter-spacing:.18em; }
  h1 { margin:18px 0; font:600 clamp(2.7rem,7vw,6rem)/.95 var(--display); letter-spacing:-.055em; }
  h1 strong { display:block; color:transparent; -webkit-text-stroke:1px rgba(244,245,246,.5); }
  p { max-width:620px; color:var(--muted); line-height:1.8; }
  a { display:inline-block; margin-top:26px; color:#05080d; background:var(--accent); padding:14px 18px; text-decoration:none; font-size:11px; font-weight:800; letter-spacing:.12em; }
</style>
