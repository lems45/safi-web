---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import SafeImage from "../../components/SafeImage.astro";
import OfficialLogo from "../../components/OfficialLogo.astro";
import { equipos } from "../../data/site";
import { withBase } from "../../utils/base";
---

<Layout
  title="Equipos | SAFI"
  description="Conoce los equipos especializados que forman parte de SAFI."
>
  <PageHero
    eyebrow="ECOSISTEMA SAFI"
    title="EQUIPOS"
    outline="ESPECIALIZADOS."
    description="Diferentes plataformas, una misma organización y una cultura compartida de ingeniería."
    image="/images/teams-hero.jpg"
  />

  <section class="section">
    <div class="container grid-2">
      {
        equipos.map((equipo, index) => (
          <a class="team reveal" href={withBase(`/equipos/${equipo.slug}`)}>
            <span class="number">0{index + 1}</span>

            <div class="image">
              <SafeImage
                src={equipo.imagen}
                alt={equipo.nombre}
              />
            </div>

            <div class="content">
              <OfficialLogo
                type={equipo.slug === "potrorockets" ? "potrorockets" : "dyson_swarm"}
                size="medium"
                alt={equipo.nombre}
              />

              <small>{equipo.subtitulo}</small>
              <h2>{equipo.nombre}</h2>
              <p>{equipo.descripcion}</p>
              <b>CONOCER EQUIPO ↗</b>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</Layout>

<style>
  .team {
    position: relative;
    border: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    background: #080c12;
    overflow: hidden;
    transition: transform .28s ease, border-color .28s ease, box-shadow .28s ease;
  }

  .team:hover {
    transform: translateY(-5px);
    border-color: rgba(115,255,157,.5);
    box-shadow: 0 20px 55px rgba(0,0,0,.38);
  }

  .number {
    position: absolute;
    z-index: 3;
    top: 18px;
    right: 18px;
    padding: 7px;
    background: rgba(5,8,13,.75);
    font-size: 11px;
  }

  .image {
    height: 330px;
    overflow: hidden;
  }

  .image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .5s ease;
  }

  .team:hover .image :global(img) {
    transform: scale(1.035);
  }

  .content {
    padding: 28px;
  }

  .content > small {
    display: block;
    margin-top: 22px;
    color: var(--accent);
    font-size: 11px;
  }

  .content h2 {
    margin: 8px 0;
    font: 600 38px var(--display);
  }

  .content p {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.8;
  }

  .content b {
    display: block;
    margin-top: 25px;
    font-size: 11px;
  }
</style>
