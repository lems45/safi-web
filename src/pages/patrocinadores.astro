---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import SafeImage from "../components/SafeImage.astro";
import { patrocinadores } from "../data/sponsors";
import { configuracion } from "../data/site";
---

<Layout
  title="Patrocinadores | SAFI"
  description="Oportunidades de colaboración y patrocinio con SAFI."
>
  <PageHero
    eyebrow="VINCULACIÓN"
    title="CONSTRUYAMOS"
    outline="JUNTOS."
    description="La colaboración con empresas e instituciones permite convertir proyectos universitarios en sistemas capaces de ser construidos, probados y operados."
    image="/images/sponsors-hero.jpg"
  />

  <section class="section">
    <div class="container grid-2">
      <div>
        <div class="label">¿POR QUÉ APOYAR A SAFI?</div>

        <h2 class="title">
          APOYAR<br />
          <span>INGENIERÍA REAL.</span>
        </h2>
      </div>

      <p class="lead">
        SAFI desarrolla proyectos de ingeniería aplicada que conectan
        estudiantes, universidad, industria y competencias nacionales e
        internacionales.
      </p>
    </div>

    <div class="container proofs">
      <article>
        <span>01</span>
        <strong>TRAYECTORIA</strong>
        <p>Participaciones documentadas desde 2021.</p>
      </article>

      <article>
        <span>02</span>
        <strong>COMPETENCIAS</strong>
        <p>Experiencia en ENMICE, CanSat Competition y LASC.</p>
      </article>

      <article>
        <span>03</span>
        <strong>RESULTADOS</strong>
        <p>1.er lugar en la categoría de 5 km de ENMICE 2025.</p>
      </article>

      <article>
        <span>04</span>
        <strong>FORMACIÓN</strong>
        <p>Experiencia técnica y desarrollo de capacidades estudiantiles.</p>
      </article>
    </div>
  </section>

  <section class="section dark">
    <div class="container">
      <div class="label">FORMAS DE COLABORAR</div>

      <h2 class="title">
        CAPACIDADES QUE<br />
        <span>HACEN POSIBLE UNA MISIÓN.</span>
      </h2>

      <div class="proofs">
        <article>
          <span>01</span>
          <strong>TECNOLOGÍA</strong>
          <p>Sensores, electrónica, telecomunicaciones e instrumentación.</p>
        </article>

        <article>
          <span>02</span>
          <strong>MANUFACTURA</strong>
          <p>CNC, impresión 3D, materiales, composites y procesos.</p>
        </article>

        <article>
          <span>03</span>
          <strong>OPERACIÓN</strong>
          <p>Herramientas, infraestructura, transporte y logística.</p>
        </article>

        <article>
          <span>04</span>
          <strong>FINANCIAMIENTO</strong>
          <p>Pruebas, materiales, competencias e investigación.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="label">PATROCINADORES ACTUALES</div>

      <h2 class="title">
        QUIENES YA<br />
        <span>IMPULSAN SAFI.</span>
      </h2>

      <div class="sponsors">
        {
          patrocinadores.length > 0
            ? patrocinadores.map((patrocinador) => (
                <a
                  href={patrocinador.url || "#"}
                  target={patrocinador.url ? "_blank" : undefined}
                  rel={patrocinador.url ? "noopener" : undefined}
                >
                  <SafeImage
                    src={patrocinador.logo}
                    alt={patrocinador.nombre}
                  />

                  <span>{patrocinador.nombre}</span>
                </a>
              ))
            : (
                <div class="placeholder">
                  <SafeImage
                    src="/images/coming-soon.jpg"
                    alt="Patrocinadores SAFI próximamente"
                  />

                  <p>
                    Agrega los patrocinadores oficiales en
                    <code>src/data/sponsors.ts</code>.
                  </p>
                </div>
              )
        }
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="container contact">
      <div>
        <div class="label">COLABORACIÓN</div>

        <h2>
          ¿QUIERES APOYAR<br />
          <span>UNA MISIÓN?</span>
        </h2>

        <p>
          Podemos presentar los proyectos actuales, necesidades técnicas y
          posibilidades de colaboración.
        </p>
      </div>

      <a href={`mailto:${configuracion.correo}`}>
        <span>CONTACTAR A SAFI</span>
        <b>↗</b>
      </a>
    </div>
  </section>
</Layout>

<style>
  .proofs {
    margin-top: 55px;
    display: grid;
    grid-template-columns: repeat(4,1fr);
  }

  .proofs article {
    min-height: 240px;
    padding: 26px;
    border: 1px solid var(--border);
    background: #080c12;
  }

  .proofs span {
    color: #505964;
    font-size: 8px;
  }

  .proofs strong {
    display: block;
    margin-top: 70px;
    font: 500 17px var(--display);
  }

  .proofs p {
    color: var(--muted);
    font-size: 11px;
    line-height: 1.75;
  }

  .dark { background: #070a0f; }

  .sponsors {
    margin-top: 50px;
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 14px;
  }

  .sponsors a {
    min-height: 190px;
    padding: 25px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background: #080c12;
    color: var(--text);
    border: 1px solid var(--border);
    text-decoration: none;
    text-align: center;
    transition: .25s ease;
  }

  .sponsors a:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  .sponsors a :global(img) {
    width: auto;
    max-width: 90%;
    height: auto;
    max-height: 100px;
    object-fit: contain;
    background: transparent;
  }

  .sponsors a span {
    margin-top: 18px;
    font-weight: 700;
  }

  .placeholder {
    grid-column: 1 / -1;
    border: 1px dashed #3a444e;
    overflow: hidden;
  }

  .placeholder :global(img) {
    width: 100%;
    max-height: 360px;
    object-fit: cover;
  }

  .placeholder p {
    padding: 18px 25px;
    color: var(--muted);
  }

  .contact {
    padding: 65px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 60px;
    align-items: center;
    border: 1px solid var(--border);
  }

  .contact h2 {
    margin: 15px 0 20px;
    font: 600 clamp(50px,6vw,82px)/.9 var(--display);
  }

  .contact h2 span { color: var(--accent); }

  .contact p {
    max-width: 620px;
    color: var(--muted);
  }

  .contact > a {
    width: 195px;
    height: 195px;
    padding: 25px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--accent);
    color: #05080d;
    text-decoration: none;
    font-size: 9px;
    font-weight: 800;
  }

  .contact > a b {
    align-self: flex-end;
    font-size: 28px;
  }

  @media(max-width:900px) {
    .proofs,
    .sponsors,
    .contact {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media(max-width:600px) {
    .proofs,
    .sponsors,
    .contact {
      grid-template-columns: 1fr;
    }

    .contact { padding: 35px; }
  }
</style>
